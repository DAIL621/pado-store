# 파도스토리 MVP 자사몰 환경변수 예시
# 이 파일을 복사해서 .env.local 파일을 만들고, 실제 값을 입력하세요.

# 1) Supabase 기본 연결값
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# 2) Supabase 서버 관리자 키
# 관리자 상품 등록, 주문 생성처럼 서버에서 DB에 저장할 때 사용
# 절대 브라우저에 노출하면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 3) Kakao 로그인
# Kakao Developers에서 REST API 키를 입력
NEXT_PUBLIC_KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY

# 3-1) 운영 사이트 URL
# Vercel 배포 URL 또는 연결한 도메인 주소를 입력
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN

# 4) Toss Payments
# Toss Payments 개발자센터에서 테스트 키부터 입력
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=YOUR_TOSS_CLIENT_KEY
TOSS_PAYMENTS_SECRET_KEY=YOUR_TOSS_SECRET_KEY

# 5) 개발용 임시 관리자 로그인
# 카카오 로그인 설정 전 로컬에서 관리자 화면만 테스트할 때 사용
# 운영 배포 전에는 반드시 false로 바꾸거나 삭제하세요.
DEV_ADMIN_LOGIN_ENABLED=false
DEV_ADMIN_PASSWORD=CHANGE_THIS_TEMP_PASSWORD

# 6) Operation notification provider
# mock | kakao_alimtalk | sms | email
PADO_NOTIFICATION_PROVIDER=mock
KAKAO_ALIMTALK_WEBHOOK_URL=
KAKAO_ALIMTALK_API_KEY=
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_WEBHOOK_URL=
EMAIL_PROVIDER_API_KEY=

# 7) Product image storage
# local | supabase
# Production should use supabase.
PADO_PRODUCT_IMAGE_STORAGE=supabase
SUPABASE_PRODUCT_IMAGE_BUCKET=product-images
